# Environment Variables Example for SME Growth Advisor

# Sarvam AI API Key for Voice Agent proxy (Level 1 session-endpoint)
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini / Gemma API Key
GEMINI_API_KEY=your_gemini_api_key_here

# DronaHQ Agent Webhook & API Key
DRONAHQ_WEBHOOK_URL=https://agents-backend.dronahq.com/webhook/your_webhook_id
DRONAHQ_API_KEY=your_dronahq_api_key_here

# NVIDIA NIM LLM
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional: Port configuration
PORT=8080
